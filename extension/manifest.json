{
  "manifest_version": 3,
  "name": "Margin connector",
  "version": "1.0.0",
  "description": "Sends papers you open in your browser to Margin (the local paper reader), using your own logins.",
  "permissions": ["storage", "webRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}],
  "action": {"default_title": "Margin", "default_popup": "popup.html", "default_icon": {"128": "icon128.png"}},
  "icons": {"128": "icon128.png"}
}
